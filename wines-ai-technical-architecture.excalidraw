      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "id": "t60",
      "type": "text",
      "x": 3151,
      "y": 1260.0,
      "width": 1438,
      "height": 60.0,
      "text": "3 \u00b7 REFINE WORKFLOW\nParses the delta ('too sweet', 'something lighter', 'less oaky') against the PREVIOUS result set, mutates the profile on that axis only, and re-runs retrieval over the documents\nalready retrieved for this conversation PLUS a widened candidate set \u2014 so the correction is anchored to what the user actually saw. Never re-interviews.",
      "originalText": "3 \u00b7 REFINE  WORKFLOW\nParses the delta ('too sweet', 'something lighter', 'less oaky') against the PREVIOUS result set, mutates the profile on that axis only, and re-runs retrieval over the documents already retrieved for this conversation PLUS a widened candidate set \u2014 so the correction is anchored to what the user actually saw. Never re-interviews.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b59",
      "lineHeight": 1.25,
      "autoResize": false
    },
