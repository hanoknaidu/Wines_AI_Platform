      "id": "t160",
      "type": "text",
      "x": 4399,
      "y": 3951,
      "width": 978,
      "height": 131.2,
      "text": "5 \u00b7 HUMAN REVIEW + FREEZE\n\nEvery flagged row and field checked by a person; review_status recorded per row; what the review changed is recorded too.\n\nThen frozen: a version-pinned artifact committed to the repo.\n\nProducer names are verified here or deleted \u2014 the weakest link in the system (BRD \u00a78).",
      "originalText": "5 \u00b7 HUMAN REVIEW  +  FREEZE\n\nEvery flagged row and field checked by a person; review_status recorded per row; what the review changed is recorded too.\n\nThen frozen: a version-pinned artifact committed to the repo.\n\nProducer names are verified here or deleted \u2014 the weakest link in the system (BRD \u00a78).",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "b159",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "angle": 0,
      "strokeColor": "#a61e4d",
      "backgroundColor": "#ffdeeb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 7301,
      "version": 1,
      "versionNonce": 7302,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "t162",
          "type": "text"
        }
      ],
      "updated": 1,
      "link": null,
      "locked": false,
      "id": "b161",
      "type": "rectangle",
      "x": 5460,
      "y": 3940,
      "width": 1000,
      "height": 440
    },
    {
      "angle": 0,
      "strokeColor": "#a61e4d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 7303,
      "version": 1,
