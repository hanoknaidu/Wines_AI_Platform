      "id": "t111",
      "type": "text",
      "x": 2451,
      "y": 2813.75,
      "width": 518,
      "height": 52.5,
      "text": "E3 \u00b7 STRUCTURED SQL\nRange scan on the 7 taste axes.\nGuarantees a recall floor when both text sides miss.",
      "originalText": "E3 \u00b7 STRUCTURED SQL\nRange scan on the 7 taste axes.\nGuarantees a recall floor when both text sides miss.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
