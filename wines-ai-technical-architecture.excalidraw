      "updated": 1,
      "link": null,
      "locked": false,
      "id": "t41",
      "type": "text",
      "x": 1381,
      "y": 441,
      "width": 1418,
      "height": 375.0,
      "text": "REST + SSE API \u00b7 OpenAPI 3.1\n\nCONVERSATIONS\nPOST /api/v1/conversations NEW CONVERSATION \u2190 the 'new chat' endpoint\nGET /api/v1/conversations?cursor=&limit=20 sidebar list, paged, newest first\nGET /api/v1/conversations/{cid} full transcript + taste profile\nPATCH /api/v1/conversations/{cid} rename \u00b7 archive\nDELETE /api/v1/conversations/{cid} soft delete\n\nTURNS\nPOST /api/v1/conversations/{cid}/messages send a turn \u2192 {turn_id}, starts the graph\nGET /api/v1/conversations/{cid}/stream?after= SSE token \u00b7 card \u00b7 chips \u00b7 citation \u00b7 usage \u00b7 done\nPOST /api/v1/turns/{turn_id}/cancel abort an in-flight turn\n\nFEEDBACK & META\nPOST /api/v1/messages/{mid}/feedback thumbs up / down against a row_id\nGET /api/v1/meta/taste-axes chip vocabulary + level labels\nPOST /api/v1/age-gate confirm 21+ \u2192 sets cookie\nGET /api/v1/meta/dataset-version which frozen artifact is being served\nGET /api/v1/healthz \u00b7 /api/v1/readyz liveness \u00b7 index-loaded readiness",
      "originalText": "REST + SSE API   \u00b7   OpenAPI 3.1\n\nCONVERSATIONS\nPOST    /api/v1/conversations                       NEW CONVERSATION  \u2190 the 'new chat' endpoint\nGET     /api/v1/conversations?cursor=&limit=20      sidebar list, paged, newest first\nGET     /api/v1/conversations/{cid}                 full transcript + taste profile\nPATCH   /api/v1/conversations/{cid}                 rename \u00b7 archive\nDELETE  /api/v1/conversations/{cid}                 soft delete\n\nTURNS\nPOST    /api/v1/conversations/{cid}/messages        send a turn \u2192 {turn_id}, starts the graph\nGET     /api/v1/conversations/{cid}/stream?after=   SSE  token \u00b7 card \u00b7 chips \u00b7 citation \u00b7 usage \u00b7 done\nPOST    /api/v1/turns/{turn_id}/cancel              abort an in-flight turn\n\nFEEDBACK & META\nPOST    /api/v1/messages/{mid}/feedback             thumbs up / down against a row_id\nGET     /api/v1/meta/taste-axes                     chip vocabulary + level labels\nPOST    /api/v1/age-gate                            confirm 21+ \u2192 sets cookie\nGET     /api/v1/meta/dataset-version                which frozen artifact is being served\nGET     /api/v1/healthz   \u00b7   /api/v1/readyz        liveness \u00b7 index-loaded readiness",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "b40",
      "lineHeight": 1.25,
      "autoResize": false
    },
