      "x": 3151,
      "y": 1470.0,
      "width": 1438,
      "height": 60.0,
      "text": "4 \u00b7 OUT-OF-SCOPE / SAFETY WORKFLOW\nTemplated reply, no retrieval: no price, no availability, no health claims in either direction, no purchase path, no marketing to minors. Prompt-injection attempts never reach the\nretriever.",
      "originalText": "4 \u00b7 OUT-OF-SCOPE / SAFETY  WORKFLOW\nTemplated reply, no retrieval: no price, no availability, no health claims in either direction, no purchase path, no marketing to minors. Prompt-injection attempts never reach the retriever.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b61",
      "lineHeight": 1.25,
      "autoResize": false
    },
