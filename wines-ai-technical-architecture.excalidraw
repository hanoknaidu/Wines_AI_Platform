      "id": "b40",
      "type": "rectangle",
      "x": 1370,
      "y": 430,
      "width": 1440,
      "height": 560
    },
    {
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
