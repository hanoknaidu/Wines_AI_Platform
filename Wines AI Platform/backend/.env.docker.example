# Copy to .env.docker (git-ignored) and fill in. Contains no real secrets.
# Every value has a working default except the cookie secret, which you MUST change.

# Signs the session and age-gate cookies. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WA_COOKIE_SECRET=REPLACE-ME-with-a-long-random-string

# The browser origin(s) that will call this API (JSON list).
WA_CORS_ORIGINS=["http://localhost:5180"]

# false only when reached over plain http (e.g. localhost without TLS) -
# otherwise the browser never sends the session cookie back.
WA_COOKIE_SECURE=false

# deterministic (free, no network) | orchestrated (the A-K pipeline)
WA_ENGINE=deterministic

# offline (no key, $0) | anthropic (needs the key AND an image built with EXTRAS=orchestrator)
WA_LLM_PROVIDER=offline
# WA_ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
# WA_REQUIRE_LLM_PROVIDER=true   # fail /readyz instead of silently falling back to offline

# Server
PORT=8010
WORKERS=1
GRACEFUL_TIMEOUT=30
