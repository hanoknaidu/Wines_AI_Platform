# ---------------------------------------------------------------------------
# Wines AI backend - Phase 1 needs none of these set. Every value has a default
# that boots a working, zero-cost service. Nothing here is required to run.
# ---------------------------------------------------------------------------

# Transport
WA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
WA_COOKIE_SECRET=dev-only-change-me
WA_WIRE_CASE=snake                 # snake | camel  - flips the whole wire surface

# Storage
WA_DATABASE_URL=sqlite+aiosqlite:///./var/wines.db

# Dataset
WA_DATASET_PATH=                   # empty -> the bundled seed artifact

# Rate limits (cost control: a bounded number of turns can ever be started)
WA_RATE_LIMIT_READS_PER_MIN=120
WA_RATE_LIMIT_TURNS_PER_MIN=30

# Engine: deterministic (free, no network, BRD v1.1's serving path)
#       | orchestrated (lane 3: the intent router, the four workflows, stages A-K)
WA_ENGINE=deterministic

# ---------------------------------------------------------------------------
# Lane 3 / lane 4: the orchestrated engine and its model gateway.
# ---------------------------------------------------------------------------
# Which provider the gateway calls.
#
#   offline    (default) every stage runs - routing, hybrid retrieval, RRF, rerank,
#              MMR, packing, verification - and the three natural-language judgements
#              are answered from structure instead of from a model. No key, no network,
#              $0.00. This is a complete serving path, not a mock.
#   anthropic  the real models. Needs WA_ANTHROPIC_API_KEY and the `orchestrator`
#              extra (`uv sync --extra orchestrator`). Asking for it without either
#              logs the reason and falls back to offline rather than failing to boot.
WA_LLM_PROVIDER=offline
# WA_ANTHROPIC_API_KEY=            # absent by default; the service must boot without it
#
# What to do when the requested provider cannot be built (no key, extra not installed).
# false: degrade to offline and log it - right for a demo.
# true:  fail /readyz - right for a deployment that MEANT to call the models, where
#        silently serving templated copy is a misconfiguration in disguise.
WA_REQUIRE_LLM_PROVIDER=false

# Gateway resilience. timeout x attempts bounds the worst case one turn can spend
# waiting on an upstream; the breaker stops a broken upstream becoming a queue of
# 20-second timeouts.
WA_MODEL_TIMEOUT_SECONDS=20
WA_MODEL_MAX_ATTEMPTS=2
WA_MODEL_BREAKER_THRESHOLD=4
WA_MODEL_BREAKER_COOLDOWN_SECONDS=30
# Server-side refusal fallback on the generator: a declined request is re-run on a
# fallback model inside the same call. Without it, a refused turn simply stops.
WA_MODEL_SERVER_FALLBACKS=true

# Model tiering, straight from the architecture: the cheapest tier carries the highest
# call volume, and the expensive model only ever writes the final copy.
WA_MODEL_ROUTER=claude-haiku-5-5
WA_MODEL_REWRITER=claude-haiku-5-5
WA_MODEL_VERIFIER=claude-haiku-5-5
WA_MODEL_GENERATOR=claude-sonnet-5-5

# Cost ceilings. Exceeding them degrades to the free deterministic engine - it never
# returns an error, because a demo that stops working is worse than a demo that is cheap.
WA_COST_CEILING_PER_TURN_USD=0.05
WA_COST_CEILING_PER_SESSION_USD=0.50
WA_COST_CEILING_GLOBAL_DAILY_USD=10.00

# Token budget for the context packer. Also keeps Haiku prompts under the 100K
# tier break, beyond which its input price is 5x.
WA_CONTEXT_TOKEN_BUDGET=8000

# Retrieval (band 2). k per arm, RRF's k, MMR's lambda, the rerank cut, and the
# embedding width.
WA_RETRIEVER_K=50
WA_RRF_K=60
WA_MMR_LAMBDA=0.7
WA_RERANK_TOP_N=10
WA_EMBEDDING_DIM=384
# Stage K. The verifier is the last thing between a model and an unsourced claim,
# and it runs on the cheapest tier.
WA_VERIFY_ENABLED=true

WA_TURN_CACHE_ENABLED=true
WA_TURN_CACHE_TTL_SECONDS=3600
